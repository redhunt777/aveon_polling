{
    "info": {
        "name": "AVEON Polling — Auth Service",
        "description": "Auth service endpoints for AVEON Polling.\n\n**Folders:**\n- `Auth Service (Direct)` — calls port 3001 directly\n- `Auth Service (via Gateway)` — calls through port 3000\n\n**Collection Variables:**\n- `base_direct` → http://localhost:3001\n- `base_gateway` → http://localhost:3000\n- `access_token` — auto-set by Login requests\n- `refresh_token` — auto-set by Login requests\n- `user_id` — auto-set by Login requests",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_direct",
            "value": "http://localhost:3001",
            "type": "string"
        },
        {
            "key": "base_gateway",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "access_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "refresh_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "user_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "invite_token",
            "value": "PASTE-INVITE-TOKEN-HERE",
            "type": "string"
        },
        {
            "key": "target_user_id",
            "value": "PASTE-USER-ID-HERE",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Auth Service (Direct — port 3001)",
            "description": "Call the auth service directly on http://localhost:3001",
            "item": [
                {
                    "name": "Register (invite-only)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/register",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"token\": \"{{invite_token}}\",\n  \"password\": \"MyPassword@123\",\n  \"confirmPassword\": \"MyPassword@123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Register a new user using an invite token sent by an admin."
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (json.success && json.data) {",
                                    "  pm.collectionVariables.set('access_token',  json.data.accessToken);",
                                    "  pm.collectionVariables.set('refresh_token', json.data.refreshToken);",
                                    "  pm.collectionVariables.set('user_id',       json.data.user._id);",
                                    "  console.log('Tokens saved to collection variables');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/login",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"MyPassword@123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Login and auto-saves access_token, refresh_token, user_id to collection variables."
                    }
                },
                {
                    "name": "Refresh Token",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const json = pm.response.json();",
                                    "if (json.success && json.data) {",
                                    "  pm.collectionVariables.set('access_token',  json.data.accessToken);",
                                    "  pm.collectionVariables.set('refresh_token', json.data.refreshToken);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/refresh",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "refresh"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Issue a new access+refresh token pair using the stored refresh token."
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/logout",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": ""
                        },
                        "description": "Blacklists the current access token and deletes the refresh token from Redis."
                    }
                },
                {
                    "name": "Get Me",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/me",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "me"
                            ]
                        },
                        "description": "Returns the currently authenticated user's profile."
                    }
                },
                {
                    "name": "Send Invite  [admin]",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/invite",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "invite"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"newmember@example.com\",\n  \"name\": \"John Doe\",\n  \"membershipId\": \"MEM-001\",\n  \"role\": \"member\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Admin only. Sends an invite email with a registration link. Role can be 'admin' or 'member'."
                    }
                },
                {
                    "name": "List Invites  [admin]",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/invites",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "invites"
                            ]
                        },
                        "description": "Admin only. Returns all invites (used and pending)."
                    }
                },
                {
                    "name": "List Users  [admin]",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/users",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "users"
                            ]
                        },
                        "description": "Admin only. Returns all registered users."
                    }
                },
                {
                    "name": "Update User Role  [admin]",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/users/{{target_user_id}}/role",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "users",
                                "{{target_user_id}}",
                                "role"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"role\": \"admin\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "description": "Admin only. Update the role of a user. Set target_user_id collection variable first."
                    }
                },
                {
                    "name": "Deactivate User  [admin]",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_direct}}/auth/users/{{target_user_id}}",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "auth",
                                "users",
                                "{{target_user_id}}"
                            ]
                        },
                        "description": "Admin only. Soft-deletes a user (sets isActive=false). Cannot deactivate yourself."
                    }
                },
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_direct}}/health",
                            "host": [
                                "{{base_direct}}"
                            ],
                            "path": [
                                "health"
                            ]
                        },
                        "description": "Service liveness probe."
                    }
                }
            ]
        },
