# ============================================================
# AVEON POLLING — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Shared ------------------------------------------------
JWT_SECRET=ajfbkafasbhaewldurioqkldsdfwewoer89392qnrfwejfkwd2kwe2993rj
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- MongoDB (Docker internal) ----------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpassword

# ---- Gmail SMTP -------------------------------------------
# Use a Gmail App Password (not your regular password)
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_USER=your-club-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: broadcast poll open/close notifications to this address (e.g. a club mailing list)
NOTIFY_ALL_EMAIL=members@your-club.com

# ---- Kafka (Event Bus) ------------------------------------
# Docker-internal address (used by microservices inside Docker network)
KAFKA_BROKER=kafka:9092
# For local dev / tools running outside Docker, use:
# KAFKA_BROKER=localhost:29092
# Kafka UI is available at http://localhost:8080
EMAIL_RATE_PER_SECOND=1
EMAIL_RATE_PER_MINUTE=10

# ---- Service Ports (Docker-internal, usually no change) ---
GATEWAY_PORT=3000
AUTH_PORT=3001
POLL_PORT=3002
VOTE_PORT=3003
NOTIF_PORT=3004
MONITOR_PORT=3005
